name="finit"
arch="all"
version="4.17"
release="1"
url="https://github.com/troglobit/finit/releases/download/${version}/finit-${version}.tar.gz"
shasum="ca8b489a0ed99c17c0288e9e65e325a8f14af3734dfecf58f516c0a6f884e903"
bld_deps=("libite" "libuev")
patches=(
    "0001-cgroup-include-sm-header.patch"
    "0002-conf-include-sm-header.patch"
    "0003-preserve-boot-console.patch"
)

prerun_f() {
    :
}

configure_f() {
    local build_triplet
    build_triplet=$(sh ./aux/config.guess)

    ./configure \
        --build="$build_triplet" \
        --host="$TARGET" \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/sbin \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --runstatedir=/run \
        --enable-auto-reload \
        --disable-doc \
        --disable-contrib \
        --disable-libcap \
        --without-keventd \
        --without-sulogin \
        --without-watchdog \
        --without-libsystemd \
        --with-bash-completion-dir=no \
        --with-heading="natickOS" \
        --with-hostname=natickos \
        --with-random-seed=/var/lib/finit/random-seed \
        CC="ccache $CC --target=$TARGET --sysroot=$SYSROOT_DIR" \
        AR="$AR" \
        RANLIB="$RANLIB" \
        STRIP="$STRIP"
}

build_f() {
    make -j"$(nproc)"
}

install_f() {
    make DESTDIR="$staging_dir" install
}

postrun_f() {
    install -D -m 644 \
        "$files_dir/etc/finit.conf" \
        "$staging_dir/etc/finit.conf"

    install -d -m 755 \
        "$staging_dir/etc/finit.d/available" \
        "$staging_dir/var/lib/finit"
    #install -d -m 755 "$staging_dir/var/lib/finit"
    #local LSERVICES=("getty" "klogd" "syslogd" "dhcpcd")

    # Make finit default init
    #ln -sf finit ${FINAL_DIR}/usr/bin/init

    # Copy local filesystem to finaldir
    #cp -r ${PKG_DIR}/finit/fs/* ${FINAL_DIR}

    # Enable services by default
    #cd ${FINAL_DIR}/etc/finit.d/available
    #for service in ${SERVICES[@]}; do
    #    ln -sf available/${service}.conf ${FINAL_DIR}/etc/finit.d/${service}.conf
    #done
}
