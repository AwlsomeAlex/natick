name="libite"
arch="all"
version="2.6.2"
release="1"
url="https://github.com/troglobit/libite/releases/download/v${version}/libite-${version}.tar.xz"
shasum="0550ac5670836db85569786e00860d1d6999df8f74005307c290371c990e1dbd"
bld_deps=()

prerun_f() {
    :
}

configure_f() {
    local build_triplet
    build_triplet=$(sh ./aux/config.guess)

    ./configure \
        --build="$build_triplet" \
        --host="$TARGET" \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --enable-shared \
        --disable-static \
        --disable-doxygen-doc \
        CC="ccache $CC --target=$TARGET --sysroot=$SYSROOT_DIR" \
        AR="$AR" \
        RANLIB="$RANLIB" \
        STRIP="$STRIP"
}

build_f() {
    make -j"$(nproc)"
}

install_f() {
    make DESTDIR="$staging_dir" install
}

postrun_f() {
    # Remove libtool metadata
    rm -f -- "$staging_dir/usr/lib/libite.la"
}
