name="musl"
arch="all"
version="1.2.6"
release="1"
url="https://musl.libc.org/releases/musl-${version}.tar.gz"
shasum="d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a"
bld_deps=()
patches=(
    "0001-slowness-mapping-icov.patch"
)

prerun_f() {
    :
}

configure_f() {
    local builtins
    builtins=$(
        "$CC" \
            --target="$TARGET" \
            --sysroot="$SYSROOT_DIR" \
            --rtlib=compiler-rt \
            --print-libgcc-file-name
    )

    [[ -s "$builtins" ]] \
        || die "Compiler-rt builtins missing: $builtins"

    ./configure \
        --target="$TARGET" \
        --prefix=/usr \
        --libdir=/usr/lib \
        --syslibdir=/lib \
        --disable-gcc-wrapper \
        CC="ccache $CC --target=$TARGET --sysroot=$SYSROOT_DIR --ld-path=$TOOLCHAIN_DIR/bin/ld.lld" \
        AR="$AR" \
        RANLIB="$RANLIB" \
        LIBCC="$builtins"
}

build_f() {
    make -j"$(nproc)"
}

install_f() {
    make DESTDIR="$staging_dir" install
}

postrun_f() {
    :
}
