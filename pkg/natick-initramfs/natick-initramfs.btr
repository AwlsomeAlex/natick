name="natick-initramfs"
arch="all"
version="0.0.1"
release="2"
source_type="local"
bld_deps=()

prerun_f() {
    :
}

configure_f() {
    :
}

build_f() {
    :
}

install_f() {
    install -D -m 755 \
        "$recipe_dir/init" \
        "$staging_dir/init"

    install -D -m 644 \
        "$recipe_dir/fstab" \
        "$staging_dir/etc/fstab"

    install -D -m 644 \
        "$recipe_dir/serial.conf" \
        "$staging_dir/etc/finit.d/serial.conf"
}

postrun_f() {
    :
}
