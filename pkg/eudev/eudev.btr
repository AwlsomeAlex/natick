name="eudev"
arch="all"
version="3.2.15"
release="1"
url="https://github.com/eudev-project/eudev/releases/download/v${version}/eudev-${version}.tar.gz"
shasum="eb69809fc0d1187f2463ab2149c53aa9f42a78e59f14ebea68eae6cb6b4fc1c3"
host_deps=("gperf")
# TODO: Package 'kmod' and 'libblkid'
#bld_deps=("kmod" "libblkid")
bld_deps=()
patches=()


prerun_f() {
    :
}

configure_f() {
    local build_triplet
    build_triplet=$(sh ./config.guess)

    ./configure \
        --build="$build_triplet" \
        --host="$TARGET" \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/sbin \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --runstatedir=/run \
        --enable-shared \
        --disable-static \
        --disable-blkid \
        --disable-selinux \
        --disable-manpages \
        --disable-kmod \
        CC="ccache $CC --target=$TARGET --sysroot=$SYSROOT_DIR" \
        CXX="ccache $CXX --target=$TARGET --sysroot=$SYSROOT_DIR"
}

build_f() {
    make -j"$(nproc)"
}

install_f() {
    make DESTDIR="$staging_dir" install
}

postrun_f() {
    rm -f -- "$staging_dir/usr/lib/libudev.la"

    install -D -m 644 \
        "$files_dir/etc/default/udevd" \
        "$staging_dir/etc/default/udevd"
}
