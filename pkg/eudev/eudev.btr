name="eudev"
arch="all"
version="3.3.0"
release="1"
url="https://github.com/eudev-project/eudev/releases/download/v${version}/eudev-${version}.tar.gz"
shasum="8fba6e4f49ea4b1938828a3c2e7cc48874816c68621386e527076b6477f5d6ef"
host_deps=("gperf" "pkg-config")
bld_deps=("kmod" "libblkid")
patches=()


prerun_f() {
    :
}

configure_f() {
    local build_triplet
    build_triplet=$(sh ./build-aux/config.guess)

    ./configure \
        --build="$build_triplet" \
        --host="$TARGET" \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/sbin \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --runstatedir=/run \
        --enable-shared \
        --enable-blkid \
        --enable-kmod \
        --disable-static \
        --disable-selinux \
        --disable-manpages \
        --with-system-uid-max=999 \
        --with-system-gid-max=999 \
        --with-bashcompletiondir=no \
        --with-zshcompletiondir=no \
        CC="ccache $CC --target=$TARGET --sysroot=$SYSROOT_DIR"
}

build_f() {
    make -j"$(nproc)"
}

install_f() {
    make DESTDIR="$staging_dir" install
}

postrun_f() {
    rm -f -- "$staging_dir/usr/lib/libudev.la"

    install -D -m 644 \
        "$files_dir/etc/default/udevd" \
        "$staging_dir/etc/default/udevd"
}
