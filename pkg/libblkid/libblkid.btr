name="libblkid"
arch="all"
version="2.42.4"
release="1"
url="https://www.kernel.org/pub/linux/utils/util-linux/v${version%.*}/util-linux-${version}.tar.xz"
shasum="fbd62a100ab7bb8746ba0661255c3c48185b1e9021507c624da01fbc696330ec"
bld_deps=()
host_deps=("pkg-config")

prerun_f() {
    :
}

configure_f() {
    local build_triplet
    build_triplet=$(sh ./config/config.guess)

    ./configure \
        --build="$build_triplet" \
        --host="$TARGET" \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/sbin \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --enable-shared \
        --disable-all-programs \
        --enable-libblkid \
        --disable-asciidoc \
        --disable-gtk-doc \
        --disable-nls \
        --disable-bash-completion \
        --without-python \
        --without-systemd \
        --without-udev \
        CC="ccache $CC --target=$TARGET --sysroot=$SYSROOT_DIR" \
        AR="$AR" \
        RANLIB="$RANLIB" \
        STRIP="$STRIP"
}

build_f() {
    make -j"$(nproc)"
}

install_f() {
    make DESTDIR="$staging_dir" install
}

postrun_f() {
    # Remove libtool metadata
    rm -f -- "$staging_dir/usr/lib/libblkid.la"
}
