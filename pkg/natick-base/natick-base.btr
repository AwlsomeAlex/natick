name="natick-base"
arch="all"
version="0.0.1"
release="2"
source_type="local"
bld_deps=()

prerun_f() {
    :
}

configure_f() {
    :
}

build_f() {
    :
}

install_f() {
    install -d -m 755 "$staging_dir/etc" "$staging_dir/usr/lib"
    install -m 644 -- "$recipe_dir"/{passwd,group} "$staging_dir/etc/"
    install -m 644 -- "$recipe_dir/os-release" "$staging_dir/usr/lib/os-release"
    ln -s ../usr/lib/os-release "$staging_dir/etc/os-release"
}

postrun_f() {
    :
}