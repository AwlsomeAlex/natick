name="busybox"
arch="all"
version="1.38.0"
release="1"
url="https://busybox.net/downloads/busybox-${version}.tar.bz2"
shasum="34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2"
bld_deps=()
patches=(
    "0001-tc-guard-obsolete-cbq.patch"
)

# Local function to help variables
busybox_make() {
    make \
        ARCH="${TARGET%%-*}" \
        CROSS_COMPILE= \
        CC="ccache clang" \
        HOSTCC="$HOSTCC" \
        AR="$AR" \
        NM="$NM" \
        STRIP="$STRIP" \
        OBJCOPY="$OBJCOPY" \
        OBJDUMP="$OBJDUMP" \
        "$@"
}

prerun_f() {
    :
}

configure_f() {
    # Prepare Configuration
    busybox_make defconfig
    
    # Enable Static Linking
    sed -i \
        's/^# CONFIG_STATIC is not set$/CONFIG_STATIC=y/' \
        .config

    # Disable explicit GCC runtime
    sed -i \
        's/^CONFIG_STATIC_LIBGCC=y$/# CONFIG_STATIC_LIBGCC is not set/' \
        .config

    busybox_make oldconfig

    grep -qx 'CONFIG_STATIC=y' .config \
        || die "BusyBox static linking was not enabled"
}

build_f() {
    busybox_make -j"$(nproc)" busybox
}

install_f() {
    busybox_make CONFIG_PREFIX="$staging_dir" install
}

postrun_f() {
    :
}
