name="libuev"
arch="all"
version="2.4.1"
release="1"
url="https://github.com/troglobit/libuev/releases/download/v${version}/libuev-${version}.tar.xz"
shasum="1d171c572ca48ddd6763f76c54e77d021d4ca7beb007610f7c1fec903511977b"
bld_deps=()

prerun_f() {
    :
}

configure_f() {
    local build_triplet
    build_triplet=$(sh ./aux/config.guess)

    ./configure \
        --build="$build_triplet" \
        --host="$TARGET" \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --enable-shared \
        --disable-static \
        --disable-doxygen-doc \
        CC="ccache $CC --target=$TARGET --sysroot=$SYSROOT_DIR" \
        AR="$AR" \
        RANLIB="$RANLIB" \
        STRIP="$STRIP"
}

build_f() {
    make -j"$(nproc)"
}

install_f() {
    make DESTDIR="$staging_dir" install
}

postrun_f() {
    # Remove libtool metadata
    rm -f -- "$staging_dir/usr/lib/libuev.la"
}
